{
  "id": "com.kevin.trivia",
  "name": "Trivia",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 0,
  "permissions": {
    "proxy": [
      "https://opentdb.com/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "difficulty": {
      "type": "enum",
      "label": "Difficulty",
      "values": [
        "any",
        "easy",
        "medium",
        "hard"
      ],
      "default": "any"
    },
    "revealSec": {
      "type": "number",
      "label": "Seconds before reveal",
      "default": 9
    }
  }
}