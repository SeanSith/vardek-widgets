{
  "id": "com.kevin.marine",
  "name": "Marine Forecast",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 3600,
  "permissions": {
    "proxy": [
      "https://marine-api.open-meteo.com/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "latitude": {
      "type": "number",
      "label": "Latitude",
      "default": 37.7749
    },
    "longitude": {
      "type": "number",
      "label": "Longitude",
      "default": -122.5
    },
    "place": {
      "type": "string",
      "label": "Place name (optional)",
      "default": ""
    },
    "units": {
      "type": "enum",
      "label": "Units",
      "values": [
        "imperial",
        "metric"
      ],
      "default": "imperial"
    }
  }
}