{
  "id": "com.kevin.multiweather",
  "name": "World Weather",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 900,
  "permissions": {
    "proxy": [
      "https://api.open-meteo.com/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "cities": {
      "type": "string",
      "label": "Cities (Name,lat,lon; ...)",
      "default": "San Francisco,37.77,-122.42;New York,40.71,-74.01;London,51.51,-0.13;Tokyo,35.68,139.69;Paris,48.85,2.35;Sydney,-33.87,151.21"
    },
    "units": {
      "type": "enum",
      "label": "Units",
      "values": [
        "fahrenheit",
        "celsius"
      ],
      "default": "fahrenheit"
    }
  }
}