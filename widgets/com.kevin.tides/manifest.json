{
  "id": "com.kevin.tides",
  "name": "Tides",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 1800,
  "permissions": {
    "proxy": [
      "https://api.tidesandcurrents.noaa.gov/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "station": {
      "type": "string",
      "label": "NOAA station ID",
      "default": "9414290"
    },
    "stationName": {
      "type": "string",
      "label": "Station name (optional)",
      "default": ""
    },
    "units": {
      "type": "enum",
      "label": "Units",
      "values": [
        "english",
        "metric"
      ],
      "default": "english"
    }
  }
}