{
  "id": "com.kevin.onthisday",
  "name": "On This Day",
  "version": "1.1.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 3600,
  "permissions": {
    "proxy": [
      "https://en.wikipedia.org/**",
      "https://upload.wikimedia.org/**",
      "https://thumb.wikimedia.org/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "rotateSec": {
      "type": "number",
      "label": "Seconds per event",
      "default": 9
    },
    "category": {
      "type": "enum",
      "label": "Feature",
      "values": [
        "selected",
        "events"
      ],
      "default": "selected"
    }
  }
}