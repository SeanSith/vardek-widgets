{
  "id": "com.kevin.buoy",
  "name": "Marine Buoy",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 900,
  "permissions": {
    "proxy": [
      "https://www.ndbc.noaa.gov/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "station": {
      "type": "string",
      "label": "NDBC station ID",
      "default": "46026"
    },
    "stationName": {
      "type": "string",
      "label": "Station name (optional)",
      "default": "San Francisco"
    },
    "units": {
      "type": "enum",
      "label": "Units",
      "values": [
        "imperial",
        "metric"
      ],
      "default": "imperial"
    }
  }
}