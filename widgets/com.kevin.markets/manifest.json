{
  "id": "com.kevin.markets",
  "name": "Markets",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 3600,
  "permissions": {
    "proxy": [
      "https://api.frankfurter.dev/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "base": {
      "type": "string",
      "label": "Base currency",
      "default": "USD"
    },
    "symbols": {
      "type": "string",
      "label": "Quote currencies (comma)",
      "default": "EUR,GBP,JPY,CAD,CHF,AUD,CNY"
    }
  }
}