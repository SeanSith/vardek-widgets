{
  "id": "com.kevin.sports",
  "name": "Sports",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 120,
  "permissions": {
    "proxy": [
      "https://site.api.espn.com/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "league": {
      "type": "enum",
      "label": "League",
      "values": [
        "nfl",
        "nba",
        "mlb",
        "nhl",
        "ncaaf",
        "ncaab",
        "epl",
        "mls",
        "ucl"
      ],
      "default": "nfl"
    }
  }
}