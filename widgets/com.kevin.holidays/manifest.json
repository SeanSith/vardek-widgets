{
  "id": "com.kevin.holidays",
  "name": "Holidays",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 21600,
  "permissions": {
    "proxy": [
      "https://date.nager.at/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "country": {
      "type": "string",
      "label": "Country code (ISO, e.g. US, GB, DE)",
      "default": "US"
    }
  }
}