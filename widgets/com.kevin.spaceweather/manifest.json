{
  "id": "com.kevin.spaceweather",
  "name": "Space Weather",
  "version": "1.0.0",
  "entry": "index.html",
  "subscriptions": [],
  "refreshInterval": 600,
  "permissions": {
    "proxy": [
      "https://services.swpc.noaa.gov/**"
    ],
    "secrets": []
  },
  "sizes": [
    {
      "cols": 8,
      "rows": 2
    },
    {
      "cols": 6,
      "rows": 2
    },
    {
      "cols": 4,
      "rows": 2
    },
    {
      "cols": 3,
      "rows": 2
    },
    {
      "cols": 8,
      "rows": 1
    }
  ],
  "settingsSchema": {
    "latitude": {
      "type": "number",
      "label": "Your latitude (for aurora odds)",
      "default": 37.7749
    }
  }
}